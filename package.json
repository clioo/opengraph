{
  "name": "opengraph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:companion",
    "build:companion": "tsc -p tsconfig.companion.json",
    "companion": "node dist-companion/companion/index.js",
    "test": "npm run test:web && npm run test:companion",
    "test:web": "vitest run --config vite.config.ts",
    "test:companion": "vitest run --config vitest.companion.config.ts",
    "test:coverage": "npm run coverage:web && npm run coverage:companion",
    "coverage:web": "vitest run --config vite.config.ts --coverage",
    "coverage:companion": "vitest run --config vitest.companion.config.ts --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:mcp": "npm run build && node scripts/mcp-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "^12.8.3",
    "html-to-image": "^1.11.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
